# Cloudflare Workers static assets headers: security on every page and file, long caching for hashed assets.
# These apply to static files only. /api responses set their own headers in worker/http.ts.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/admin
  X-Robots-Tag: noindex
  Cache-Control: no-store

# Yoco sends the customer here after paying or cancelling (query: r=success|cancel|failure&ref=). Never cached, never indexed.
/order/result
  X-Robots-Tag: noindex
  Cache-Control: no-store

/llms.txt
  Content-Type: text/plain; charset=utf-8

/pricing.md
  Content-Type: text/markdown; charset=utf-8
