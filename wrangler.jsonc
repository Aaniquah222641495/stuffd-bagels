// Cloudflare Worker with static assets (ADR-0028, revised: Worker, not Pages Functions).
// The prerendered site is served as static assets; only /api and /api/* run the Worker (worker/index.ts).
// _headers in the output folder still applies to pages and images. _redirects is not needed.
//
// Secrets: ADMIN_PASSWORD is a Worker secret (dashboard, or `npx wrangler secret put ADMIN_PASSWORD`).
// Locally it lives in a git-ignored .dev.vars. Never put it in this file.
//
// Order and booking emails: APPS_SCRIPT_URL and APPS_SCRIPT_TOKEN (32+ random characters, same value as SHARED_TOKEN in the
// script) are Worker secrets too, set the same way: `npx wrangler@4.148.0 secret put APPS_SCRIPT_URL --env preview`.
// The script itself is apps-script/Code.gs (see its README). Without BOTH secrets the order and booking forms answer
// "not switched on yet": nothing is lost, nothing is sent.
//
// Rate limits: Durable Object class Limiter (worker/limiter.ts), SQLite-backed so it runs on the Workers Free plan.
// Bindings are not inherited by environments, so the preview repeats it; the migration is inherited.
//
// KV: namespaces created 2026-11-16 in the founder's account (founder yes): stuffd-kv (live) and
// stuffd-kv-preview. Ids are not secrets. Deploys now go through GitHub Actions (DEPLOY.md); by hand: `npx wrangler@4.148.0 deploy --env preview`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stuffdbagels",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "assets": {
    "directory": "./artifacts/stuffd-bagels/dist/public",
    "binding": "ASSETS",
    // Unknown paths get the prerendered 404.html with a real 404 status.
    "not_found_handling": "404-page",
    // /admin serves admin.html; /admin.html forwards to /admin.
    "html_handling": "auto-trailing-slash",
    // TEMPORARY until the public launch (founder 2026-11-19: client doesn't want to go live before payments): the Worker runs for
    // every path so NOINDEX can add X-Robots-Tag. At launch put back ["/api", "/api/*"] and remove NOINDEX from "vars" below.
    "run_worker_first": ["/*"]
  },
  // PRODUCTION (this top level = the Worker `stuffdbagels`): stuffd-kv (live), the Limiter object, and APP_ENV "production", which makes
  // admin sign-in refuse an ADMIN_PASSWORD shorter than 16 characters. No noindex header here. Secrets for production, set by the
  // founder WITHOUT --env: ADMIN_PASSWORD, LIMITER_SALT (and later APPS_SCRIPT_URL, APPS_SCRIPT_TOKEN). See go-live-runbook.md.
  "vars": { "APP_ENV": "production", "NOINDEX": "1" }, // NOINDEX: temporary, remove at public launch
  "kv_namespaces": [{ "binding": "STUFFD_KV", "id": "663cf05928e64e048205ec4dafc1354c" }],
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],
  "env": {
    // Preview for the client and the founder: separate Worker, separate KV, separate password.
    "preview": {
      "name": "stuffdbagels-preview",
      "kv_namespaces": [{ "binding": "STUFFD_KV", "id": "6487395497af4da7a4f2b493c3edc8f6" }],
      "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }] },
      // The preview is never indexed: NOINDEX makes the Worker add X-Robots-Tag to every page and file, so it must run for all paths
      // here (a few thousand extra Worker requests a month on the preview only; production keeps static requests free).
      "vars": { "APP_ENV": "preview", "NOINDEX": "1" },
      "assets": {
        "directory": "./artifacts/stuffd-bagels/dist/public",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": ["/*"]
      }
    },
    // DEV (CI/CD): a throwaway Worker the pipeline redeploys on every push to a pull-request branch. Latest push wins.
    // No Apps Script secrets are ever set on it, so the order and booking forms answer "not switched on yet" and no email is sent.
    // APP_ENV "dev" is treated like production by worker/auth.ts (admin password of 16+ characters), which is the safe side.
    // KV: not bound yet, so public pages and /api/pickups work (empty), and admin saves answer 503. To switch it on, the founder runs
    //   npx wrangler@4.148.0 kv namespace create stuffd-kv-dev
    // and pastes the printed id into the commented line below (remove the // marks). Ids are not secrets.
    // After PR "order-form-friction" merges, also add its vars here: YOCO_MODE "test", SITE_ORIGIN (this Worker's workers.dev URL) and the
    // Turnstile TEST site key (a public value that always passes).
    "dev": {
      "name": "stuffdbagels-dev",
      "preview_urls": false,
      // "kv_namespaces": [{ "binding": "STUFFD_KV", "id": "PASTE_ID_FROM_kv_namespace_create" }],
      "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }] },
      "vars": { "APP_ENV": "dev", "NOINDEX": "1" },
      "assets": {
        "directory": "./artifacts/stuffd-bagels/dist/public",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": ["/*"]
      }
    }
  }
}
