// Cloudflare Worker with static assets (ADR-0028, revised: Worker, not Pages Functions).
// The prerendered site is served as static assets; only /api and /api/* run the Worker (worker/index.ts).
// _headers in the output folder still applies to pages and images. _redirects is not needed.
//
// Secrets: ADMIN_PASSWORD is a Worker secret (dashboard, or `npx wrangler secret put ADMIN_PASSWORD`).
// Locally it lives in a git-ignored .dev.vars. Never put it in this file.
//
// Order and booking emails: APPS_SCRIPT_URL and APPS_SCRIPT_TOKEN (32+ random characters, same value as SHARED_TOKEN in the
// script) are Worker secrets too, set the same way: `npx wrangler@4.148.0 secret put APPS_SCRIPT_URL --env preview`.
// The script itself is apps-script/Code.gs (see its README). Without BOTH secrets the order and booking forms answer
// "not switched on yet": nothing is lost, nothing is sent.
//
// Yoco payments (ADR-0041). Two more Worker secrets, set by the founder at the interactive prompt (never in this file, chat or git):
//   npx wrangler@4.148.0 secret put YOCO_SECRET_KEY     --env preview     (sk_test_... on the preview; sk_live_... without --env, in production)
//   npx wrangler@4.148.0 secret put YOCO_WEBHOOK_SECRET --env preview     (whsec_..., shown ONCE when the webhook is registered)
// The Worker refuses to make checkouts (503, "not switched on yet") if either secret is missing, or if the key prefix disagrees with
// YOCO_MODE below (so a live key on the preview, or a test key in production, can never work). YOCO_MODE and SITE_ORIGIN are plain vars.
// YOCO_API_BASE (a local fake Yoco) is honoured only when it starts with http://127.0.0.1: pass it with `wrangler dev --var`, never set it here.
//
// Cloudflare Turnstile (D-SB-7): orders and bookings need a verified token before any Yoco checkout or email. TURNSTILE_SITE_KEY is a public
// plain var (below); TURNSTILE_SECRET_KEY is a Worker secret set at the prompt, never here:
//   npx wrangler@4.148.0 secret put TURNSTILE_SECRET_KEY       (production, no --env)
// The preview uses Cloudflare's documented always-pass test keys (the site key is below; the Worker falls back to the matching test secret
// when APP_ENV is preview). In production a missing secret refuses every order and booking and says so in `wrangler tail`.
//
// Rate limits: Durable Object class Limiter (worker/limiter.ts), SQLite-backed so it runs on the Workers Free plan.
// Bindings are not inherited by environments, so the preview repeats it; the migration is inherited.
//
// KV: namespaces created 2026-11-16 in the founder's account (founder yes): stuffd-kv (live) and
// stuffd-kv-preview. Ids are not secrets. Preview deploy: `npx wrangler@4.148.0 deploy --env preview`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stuffdbagels",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "assets": {
    "directory": "./artifacts/stuffd-bagels/dist/public",
    "binding": "ASSETS",
    // Unknown paths get the prerendered 404.html with a real 404 status.
    "not_found_handling": "404-page",
    // /admin serves admin.html; /admin.html forwards to /admin.
    "html_handling": "auto-trailing-slash",
    // TEMPORARY until the public launch (founder 2026-11-19: client doesn't want to go live before payments): the Worker runs for
    // every path so NOINDEX can add X-Robots-Tag. At launch put back ["/api", "/api/*"] and remove NOINDEX from "vars" below.
    "run_worker_first": ["/*"]
  },
  // PRODUCTION (this top level = the Worker `stuffdbagels`): stuffd-kv (live), the Limiter object, and APP_ENV "production", which makes
  // admin sign-in refuse an ADMIN_PASSWORD shorter than 16 characters. No noindex header here. Secrets for production, set by the
  // founder WITHOUT --env: ADMIN_PASSWORD, LIMITER_SALT (and later APPS_SCRIPT_URL, APPS_SCRIPT_TOKEN). See go-live-runbook.md.
  "kv_namespaces": [{ "binding": "STUFFD_KV", "id": "663cf05928e64e048205ec4dafc1354c" }],
  // Bindings are not inherited by environments, so the preview repeats them; the migrations are inherited.
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }, { "name": "ORDERS", "class_name": "Orders" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Limiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Orders"] }
  ],
  // Production: APP_ENV "production" (admin refuses a password under 16 characters), live Yoco, the real domain. Ordering stays
  // hidden until a pickup point exists. NOINDEX is temporary (until the public launch).
  // TURNSTILE_SITE_KEY: the PUBLIC sitekey of the "Stuff'd Bagels forms" widget (Cloudflare dashboard > Turnstile, Managed mode, hostname
  // stuffdbagels.co.za). Not a secret. The matching secret is TURNSTILE_SECRET_KEY, a Worker secret set by the founder, never here: until it is
  // set the Worker refuses every order and booking (fails closed).
  "vars": { "APP_ENV": "production", "NOINDEX": "1", "TURNSTILE_SITE_KEY": "0x4AAAAAAGIpBftgw-wYSqUM", "YOCO_MODE": "live", "SITE_ORIGIN": "https://stuffdbagels.co.za" }, // NOINDEX: temporary, remove at public launch
  "env": {
    // Preview for the client and the founder: separate Worker, separate KV, separate password.
    "preview": {
      "name": "stuffdbagels-preview",
      "kv_namespaces": [{ "binding": "STUFFD_KV", "id": "6487395497af4da7a4f2b493c3edc8f6" }],
      "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }, { "name": "ORDERS", "class_name": "Orders" }] },
      // The preview is never indexed: NOINDEX makes the Worker add X-Robots-Tag to every page and file, so it must run for all paths
      // here (a few thousand extra Worker requests a month on the preview only; production keeps static requests free).
      // Yoco TEST mode, sent back to the preview's own address. Order data here is separate from production's.
      "vars": { "APP_ENV": "preview", "NOINDEX": "1", "TURNSTILE_SITE_KEY": "1x00000000000000000000AA", "YOCO_MODE": "test", "SITE_ORIGIN": "https://stuffdbagels-preview.thedigitalpantryza.workers.dev" },
      "assets": {
        "directory": "./artifacts/stuffd-bagels/dist/public",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": ["/*"]
      }
    }
  }
}
